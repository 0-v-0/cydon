{
	"name": "cydon",
	"version": "0.2.0",
	"description": "A lightweight library for building fast, reactive web components.",
	"keywords": [
		"cydon",
		"directives",
		"progressive",
		"progressive enhancement",
		"reactive",
		"templating"
	],
	"homepage": "https://0-v-0.github.io/cydon",
	"license": "MIT",
	"author": "0-v-0 <kduice@qq.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0-v-0/cydon",
		"directory": "packages/cydon"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/cydon.js",
	"module": "dist/cydon.js",
	"types": "./dist/cydon.d.ts",
	"unpkg": "dist/cydon.iife.js",
	"jsdelivr": "dist/cydon.iife.js",
	"exports": {
		".": {
			"types": "./dist/cydon.d.ts",
			"default": "./dist/cydon.js"
		},
		"./events": {
			"types": "./dist/events.d.ts",
			"default": "./dist/events.js"
		},
		"./package.json": "./package.json",
		"./declarative": "./dist/declarative.js"
	},
	"scripts": {
		"build": "vite build && vite build --config vite.iife.ts && vite build --config vite.iife.ts --mode declarative",
		"test": "vitest run",
		"prepublishOnly": "pnpm test && pnpm build"
	}
}
